# Generated by .github/release/formula.sh after the release archives are uploaded.
class Norn < Formula
  desc "Local temporal data engine with gRPC and optional MCP"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "AGPL-3.0-or-later"

  # Downloads release assets through the GitHub asset API.
  # Without an environment token, curl may use an explicitly enabled .netrc.
  download_headers = ["Accept: application/octet-stream"]
  token = ENV["HOMEBREW_GITHUB_API_TOKEN"]
  download_headers << "Authorization: Bearer #{token}" if token.present?

  on_macos do
    on_arm do
@MAC_ARM@
    end
    on_intel do
@MAC_INTEL@
    end
  end

  on_linux do
    on_arm do
@LINUX_ARM@
    end
    on_intel do
@LINUX_INTEL@
    end
  end

  def install
    bin.install "norn", "nornctl"
    (buildpath/"norn.toml").write <<~TOML
      listen = "unix:#{var}/run/norn/norn.sock"
      data_dir = "#{var}/norn"

      [mcp]
      enabled = false
    TOML
    (etc/"norn").install "norn.toml"
    pkgshare.install "docs"
    prefix.install "LICENSE", "LICENSE-COMMERCIAL.md"
  end

  post_install_steps do
    mkdir_p "norn", base: :var
    mkdir_p "run/norn", base: :var
    mkdir_p "log", base: :var
    touch "log/norn.log", base: :var
    set_permissions ["norn", "run/norn"], "0700", base: :var, recursive: false
    set_permissions "log/norn.log", "0600", base: :var, recursive: false
  end

  service do
    run [opt_bin/"norn", "--config", etc/"norn/norn.toml"]
    keep_alive true
    stop_timeout 30
    working_dir var/"norn"
    log_path var/"log/norn.log"
    error_log_path var/"log/norn.log"
  end

  def caveats
    <<~EOS
      Installation does not start Norn. To run it at login:
        brew services start norn
      Configuration: #{etc}/norn/norn.toml (preserved on upgrade)
      Health: nornctl --endpoint unix:#{var}/run/norn/norn.sock status
      After an upgrade: brew services restart norn
      Run the service as your Homebrew user, without sudo.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/norn --version")
    assert_match "nornctl", shell_output("#{bin}/nornctl --help")
  end
end
